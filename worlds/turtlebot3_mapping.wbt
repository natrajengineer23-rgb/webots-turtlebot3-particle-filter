#VRML_SIM R2025a utf8
# Self-contained arena adapted from Cyberbotics' Apache-2.0 TurtleBot3 sample.
# Only the official R2025a robot PROTO is downloaded; the arena uses base nodes so
# it also works when a macOS Webots installation omits its optional projects tree.

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/robotis/turtlebot/protos/TurtleBot3Burger.proto"

WorldInfo {
  basicTimeStep 64
}
Viewpoint {
  orientation 0.30472332270793473 0.6830874932044873 -0.6637282374778442 1.1835111768575177
  position -1.5731172225512131 1.6462057351100228 2.506237334848655
  follow "TurtleBot3Burger"
  followType "Pan and Tilt Shot"
}
Background {
  skyColor [
    0.75 0.82 0.9
  ]
}
DirectionalLight {
  ambientIntensity 1
  direction -0.4 -0.6 -1
}
Solid {
  translation 0 0 -0.025
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.72 0.72 0.72
        roughness 1
        metalness 0
      }
      geometry Box {
        size 6 6 0.05
      }
    }
  ]
  name "arena floor"
  boundingObject Box {
